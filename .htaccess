# 1. & 2. & 3. FORCE HTTPS AND NON-WWW CANONICALIZATION (Must be first)
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Combined Rule: Redirect HTTP to HTTPS OR WWW to NON-WWW
    # If the request is NOT HTTPS, OR if the host starts with www.
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\. [NC]
    # Then redirect to https://skjal.in permanently
    RewriteRule ^(.*)$ https://skjal.in/$1 [L,R=301,NE]
</IfModule>

# 4. & 5. STRICT SECURITY HEADERS
<IfModule mod_headers.c>
    # Enable HSTS (Strict-Transport-Security) for 1 year
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    
    # Prevent Clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # Prevent MIME-sniffing
    Header always set X-Content-Type-Options "nosniff"
    
    # Enable cross-site scripting filter
    Header always set X-XSS-Protection "1; mode=block"
    
    # Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 6. ENABLE GZIP COMPRESSION
<IfModule mod_deflate.c>
    # Compress HTML, CSS, JavaScript, Text, XML, JSON, and fonts
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/ld+json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE application/font-woff
    AddOutputFilterByType DEFLATE application/font-woff2
</IfModule>

# 7. CACHE CONTROL HEADERS
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Default expiry
    ExpiresDefault "access plus 1 month"
    
    # HTML: No cache (always fresh for SEO)
    ExpiresByType text/html "access plus 0 seconds"
    
    # CSS & JavaScript: 1 Year (long-term for performance)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    
    # Images & Media: 1 Year
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    # Ensure HTML files are revalidated
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
    
    # Ensure static assets are cached long term
    <FilesMatch "\.(css|js|webp|jpg|jpeg|png|svg|woff|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# 8. HANDLE CLEAN URLS (REMOVE .html EXTENSION)
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Redirect requests with .html extension to URL without .html
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^.]+)\.html\ HTTP
    RewriteRule ^([^.]+)\.html$ https://skjal.in/$1 [R=301,L]
    
    # Internally add .html extension if the file exists
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.html -f
    RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# 9. CUSTOM 404 REDIRECT TO HOMEPAGE
ErrorDocument 404 /index.html
