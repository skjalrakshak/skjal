{
  "version": 2,
  "cleanUrls": true,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "favicon.svg",
          "index.html",
          "404.html",
          "jal-rakshak.html",
          "shield.html",
          "energy-monitoring.html",
          "style.css",
          "script.js",
          "webgl.js",
          "img/**",
          "assets/**"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/server.js" }
  ]
}
