# Vercel Deployment Exclusions
# Explicitly block all files that are not strictly required at edge runtime.

# Source Control & Configuration
.git/
.gitignore
.vercelignore

# Build Tools & Local Scripts
tools/
scripts/
dev-server.js

# Documentation
*.md
README.md
design_system.md
docs/

# Logs & Debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
scratch/

# OS Generated
.DS_Store
Thumbs.db

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo

# Environment Variables
.env
.env.*
